{
  "name": "dsh-cost-profiler",
  "description": "Turn-level cost & performance profiler for the DeepSeek Harness: per-turn token/latency/cost attribution, slow-tool ranking, and a /cost session report",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cost",
    "tokens",
    "profiler",
    "performance"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "sync": "node scripts/sync-profile.mjs"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1"
  }
}
